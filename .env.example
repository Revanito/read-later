ONE_MIN_API_KEY=your_1min_ai_api_key
ONE_MIN_BASE_URL=https://api.1min.ai
MODEL_SUMMARIZER=us.anthropic.claude-haiku-5-5
MODEL_RECOMMENDER=us.anthropic.claude-haiku-5-5
DB_PATH=/data/read-later.db
MAX_ARTICLE_CHARS=20000

# Required: the single password that protects the whole app.
APP_PASSWORD=change_me
# Optional: signs session cookies. Leave empty to derive it from APP_PASSWORD.
SECRET_KEY=
SESSION_DAYS=30

# Optional: Hardcover personal access token (hardcover.app -> Settings -> Hardcover API).
# Only the read:catalog scope is needed. Leave empty to use Open Library only.
HARDCOVER_TOKEN=
